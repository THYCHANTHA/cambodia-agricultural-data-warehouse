# Copy to .env (git-ignored) and fill in. Never commit the real file.
CADW_DB_HOST=localhost
CADW_DB_PORT=5432
CADW_DB_NAME=cambodia_dw
CADW_DB_USER=cadw
CADW_DB_PASSWORD=

# CHIRPS window (inclusive). Each month costs roughly 14 s to read.
CADW_CHIRPS_START_YEAR=2000
CADW_CHIRPS_END_YEAR=2024

# Path to the dbt executable (dbt is installed in a separate virtualenv).
CADW_DBT_BIN=.venv-dbt/Scripts/dbt.exe
